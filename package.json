{
  "name": "@variamosple/variamos-components",
  "private": false,
  "version": "0.3.0",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig.lib.json && vite build",
    "check-package": "node scripts/check-package.mjs && publint --strict",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check --error-on-warnings . && node scripts/check-suppressions.mjs",
    "format": "biome format --write .",
    "find-deadcode": "knip",
    "preview": "vite preview",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-bootstrap": "^2.10.9",
    "react-bootstrap-icons": "^1.11.5",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "glob": "^14.0.4",
    "knip": "^6.45.1",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.7.2",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.1",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
